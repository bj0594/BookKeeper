@host = http://localhost:8080

# @name createBook
POST {{host}}/books
Content-Type: application/json

{ "title": "Dune", "author": "Frank Herbert" }

### List all books
GET {{host}}/books

### Loan the book
PATCH {{host}}/books/{{createBook.response.body.$.id}}/loan

### Loan the same book again (expect 409)
PATCH {{host}}/books/{{createBook.response.body.$.id}}/loan

### Return the book
PATCH {{host}}/books/{{createBook.response.body.$.id}}/return

### Return the same book again (expect 409)
PATCH {{host}}/books/{{createBook.response.body.$.id}}/return

### Delete the book
DELETE {{host}}/books/{{createBook.response.body.$.id}}
