@page "/register"
@rendermode InteractiveServer
@using BookKeeper.Web.Api
@inject IAuthClient Auth
@inject NavigationManager Navigation

<h1>Register</h1>

<form @onsubmit="Register">
    <input id="username" @bind="_username" placeholder="Username" required />
    <input id="password" @bind="_password" type="password" placeholder="Password" required />
    <select id="role" @bind="_role">
        <option value="LibraryUser">Library user</option>
        <option value="Librarian">Librarian</option>
    </select>
    <button type="submit">Register</button>
</form>

@if (_failed)
{
    <p class="error">Could not register. The username is taken, or a librarian already exists.</p>
}

<p>Already registered? <a href="login">Log in</a></p>

@code {
    private string _username = "";
    private string _password = "";
    private string _role = "LibraryUser";
    private bool _failed;

    private async Task Register()
    {
        _failed = !await Auth.RegisterAsync(_username, _password, _role);
        if (!_failed)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
