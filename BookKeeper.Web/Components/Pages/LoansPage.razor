@page "/loans"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net
@using BookKeeper.Web.Api
@inject IBooksClient Client
@inject TokenStore Tokens
@inject NavigationManager Navigation

<h1>My loans</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_items is null)
{
    <p>Loading…</p>
}
else if (_items.Count == 0 && _error is null)
{
    <p>You have no loans. Loan a book on the <a href="books">Books</a> page.</p>
}
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li>
                <span>@item.Title by @item.Author</span>
                <button class="return" @onclick="() => Return(item.Id)">Return</button>
            </li>
        }
    </ul>
}

@code {
    private List<BookDto>? _items;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Tokens.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _items = await Client.GetLoansAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The token has expired: log out, and let the user log in again.
            Tokens.LogOut();
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            _items = [];
        }
    }

    private async Task Return(Guid id)
    {
        try
        {
            _error = null;
            await Client.ReturnBookAsync(id);
            _items = await Client.GetLoansAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }
}
