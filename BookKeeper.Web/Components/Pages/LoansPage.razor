@page "/loans"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BookKeeper.Web.Api
@inject IBooksClient Client
@inject TokenStore Tokens
@inject NavigationManager Navigation

<h1>My loans</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (_items is null)
{
    <p>Loading…</p>
}
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li>@item.Title by @item.Author <button class="return" @onclick="() => Return(item.Id)">Return</button></li>
        }
    </ul>
}

@code {
    private List<BookDto>? _items;
    private string? _error;

    protected override async Task OnInitializedAsync()
{
    if (!Tokens.IsLoggedIn)
    {
        Navigation.NavigateTo("/login");
        return;
    }

    _items = await Client.GetLoansAsync();
}

    private async Task Return(Guid id)
    {
        try
        {
            _error = null;
            await Client.ReturnBookAsync(id);
            _items = await Client.GetLoansAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }
}
