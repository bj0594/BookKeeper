@page "/books"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net
@using BookKeeper.Web.Api
@inject IBooksClient Client
@inject TokenStore Tokens
@inject NavigationManager Navigation

<h1>Books</h1>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@if (Tokens.Role == "Librarian")
{
    <form @onsubmit="Add">
        <input id="title" @bind="_newTitle" placeholder="Title" required />
        <input id="author" @bind="_newAuthor" placeholder="Author" required />
        <button type="submit">Add</button>
    </form>
}

@if (_items is null)
{
    <p>Loading…</p>
}
else if (_items.Count == 0)
{
    <p>No books to show.</p>
}
else
{
    <ul>
        @foreach (var item in _items)
        {
            <li>
                <span>@item.Title by @item.Author</span>
                @if (item.IsLoaned)
                {
                    <span class="status">Loaned</span>
                }
                @if (Tokens.Role == "LibraryUser")
                {
                    <button class="loan" @onclick="() => Loan(item.Id)">Loan</button>
                }
                @if (Tokens.Role == "Librarian")
                {
                    <button class="delete" @onclick="() => Delete(item.Id)">Delete</button>
                }
            </li>
        }
    </ul>
}

@code {
    private List<BookDto>? _items;
    private string? _error;
    private string _newTitle = "";
    private string _newAuthor = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Tokens.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            _items = await Client.GetBooksAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // The token has expired: log out, and let the user log in again.
            Tokens.LogOut();
            Navigation.NavigateTo("/login");
        }
    }

    private async Task Add()
    {
        try
        {
            _error = null;
            await Client.AddBookAsync(_newTitle, _newAuthor);
            _newTitle = "";
            _newAuthor = "";
            _items = await Client.GetBooksAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Loan(Guid id)
    {
        try
        {
            _error = null;
            await Client.LoanBookAsync(id);
            _items = await Client.GetBooksAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Delete(Guid id)
    {
        try
        {
            _error = null;
            await Client.DeleteBookAsync(id);
            _items = await Client.GetBooksAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }
}
